# Caddy reverse proxy for hermes-webui zero-downtime (blue-green) deploys.
#
# Caddy owns the public port and stays up across deploys. The upstream is the
# FIXED Docker network alias `hermes-webui-active`, which scripts/deploy-bluegreen.sh
# reassigns to whichever color (blue/green) is healthy and serving. Because this
# config never changes, Caddy can never end up pointing at a dead color — even
# across reloads or restarts it always resolves the alias to the live container.
{
	# Plain HTTP on the container port for parity with the existing CI setup.
	# To terminate TLS, replace `:8899` below with your hostname and drop this.
	auto_https off
	# Admin API is used by `caddy reload` (invoked via `docker exec`).
	admin 0.0.0.0:2019
}

:8899 {
	encode zstd gzip
	# `flush_interval -1` disables response buffering so SSE / streaming
	# (api/sessions/events, live agent output) is delivered immediately.
	reverse_proxy hermes-webui-active:8787 {
		flush_interval -1
	}
}
